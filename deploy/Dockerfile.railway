# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Railway image for the company-OS Paperclip control plane.
#
# We layer onto the maintainers' PREBUILT image rather than build from source:
# upstream's source build currently fails `tsc` (an @types/express-serve-static-core
# 5.1.x drift breaks the global Express.Request `actor` augmentation, plus a stray
# route-param type error). The published image is built green by their CI, so we
# start from it and only add what we need.
#
# Adds: the Fabro CLI, so Paperclip's in-container agents (claude-local / codex-local)
# can invoke deterministic Fabro workflows.
#
# Inherits ENTRYPOINT (docker-entrypoint.sh → gosu node) and CMD from the base.
# Volume writability is handled by the USER_GID=1001 env override on the Railway
# service, which makes the inherited entrypoint chown the root-owned /paperclip
# volume to the node user on boot.
# ─────────────────────────────────────────────────────────────────────────────
FROM ghcr.io/paperclipai/paperclip:sha-70b1a91

USER root

# ── Fabro CLI (deterministic workflow runtime our agents invoke) ─────────────
# curl + jq already exist in the base image. Pull the pinned release tarball
# directly (bypasses install.sh, which needs authenticated gh at build time).
# Debian trixie = glibc → -gnu target. Bump FABRO_VERSION to upgrade.
ARG FABRO_VERSION=v0.252.0
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
      x86_64)  T="x86_64-unknown-linux-gnu" ;; \
      aarch64) T="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported arch $ARCH"; exit 1 ;; \
    esac; \
    URL="$(curl -fsSL "https://api.github.com/repos/fabro-sh/fabro/releases/tags/${FABRO_VERSION}" \
      | jq -r --arg t "fabro-${T}.tar.gz" '.assets[] | select(.name==$t) | .browser_download_url')"; \
    test -n "$URL" || { echo "fabro asset not found for ${FABRO_VERSION}/${T}"; exit 1; }; \
    curl -fsSL "$URL" | tar xz -C /tmp; \
    mv "/tmp/fabro-${T}/fabro" /usr/local/bin/fabro; \
    chmod 0755 /usr/local/bin/fabro; \
    fabro --version

# ── Company tool CLIs agents invoke (pinned; bump deliberately) ──────────────
# These are TOOLS agents call (deploy/data), not agent adapters. Auth (where
# needed) is done per-CLI via `railway ssh` and persists on the /paperclip volume.
RUN npm install -g --omit=dev \
      bun@1.3.14 \
      convex@1.40.0 \
      vercel@54.7.1 \
      @railway/cli@4.66.1 \
      wrangler@4.97.0 \
 && bun --version

# ── Supabase CLI (GitHub release binary — not published to npm) ──────────────
ARG SUPABASE_VERSION=2.104.0
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "$ARCH" in \
      amd64) A=amd64 ;; \
      arm64) A=arm64 ;; \
      *) echo "unsupported arch $ARCH"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/supabase/cli/releases/download/v${SUPABASE_VERSION}/supabase_${SUPABASE_VERSION}_linux_${A}.tar.gz" \
      | tar xz -C /tmp supabase; \
    mv /tmp/supabase /usr/local/bin/supabase; \
    chmod 0755 /usr/local/bin/supabase; \
    supabase --version
